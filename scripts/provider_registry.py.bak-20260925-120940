"""
WhatsApp Business Agent Provider Registry
Handles connections to WhatsApp (Baileys), Google Calendar, and other services
"""

import os
import json
from typing import Dict, Any, Optional
from datetime import datetime, timedelta

class WhatsAppBusinessProviderRegistry:
    def __init__(self, business_id: str):
        self.business_id = business_id
        self.config = self._load_business_config()
        self.whatsapp_client = None
        self.calendar_service = None
        
    def _load_business_config(self) -> Dict[str, Any]:
        """Load business-specific configuration"""
        config_path = f"/home/ubuntu/.hermes/businesses/{self.business_id}/config/config.yaml"
        try:
            import yaml
            with open(config_path, 'r') as f:
                return yaml.safe_load(f)
        except Exception as e:
            print(f"Error loading config for {self.business_id}: {e}")
            return self._get_default_config()
    
    def _get_default_config(self) -> Dict[str, Any]:
        """Return default configuration"""
        return {
            "whatsapp": {
                "session_file": f"/data/whatsapp/sessions/{self.business_id}.json",
                "webhook_port": 3000
            },
            "calendar": {
                "enabled": False,
                "type": "google",
                "credentials_file": f"/home/ubuntu/.hermes/businesses/{self.business_id}/config/calendar_credentials.json"
            },
            "database": {
                "type": "postgresql",
                "host": "localhost",
                "port": 5432,
                "database": f"whatsapp_business_{self.business_id}",
                "user": "agency_user",
                "password": "secure_password"
            },
            "business": {
                "name": "",
                "type": "general",  # restaurant, salon, clinic, etc.
                "timezone": "Asia/Kolkata",
                "working_hours": {"start": "09:00", "end": "18:00"}
            }
        }
    
    def get_whatsapp_client(self):
        """Initialize and return WhatsApp client (Baileys)"""
        if self.whatsapp_client is None:
            try:
                # Import Baileys equivalent for Python (using selenium or similar approach)
                # For now, we'll use the existing WhatsApp bot connection
                from hermes_tools import terminal
                # Check if WhatsApp bot is running for this business
                session_file = self.config["whatsapp"]["session_file"]
                if os.path.exists(session_file):
                    # Use existing WhatsApp connection via Hermes
                    self.whatsapp_client = "hermes_whatsapp_bridge"
                else:
                    print(f"WhatsApp session not found for {self.business_id}. Please scan QR code.")
                    self.whatsapp_client = None
            except Exception as e:
                print(f"Error initializing WhatsApp client: {e}")
                self.whatsapp_client = None
        return self.whatsapp_client
    
    def get_calendar_service(self):
        """Initialize and return calendar service"""
        if self.calendar_service is None and self.config["calendar"]["enabled"]:
            try:
                if self.config["calendar"]["type"] == "google":
                    from google.oauth2 import service_account
                    from googleapiclient.discovery import build
                    
                    creds_file = self.config["calendar"]["credentials_file"]
                    if os.path.exists(creds_file):
                        credentials = service_account.Credentials.from_service_account_file(
                            creds_file,
                            scopes=['https://www.googleapis.com/auth/calendar']
                        )
                        self.calendar_service = build('calendar', 'v3', credentials=credentials)
                    else:
                        print(f"Google Calendar credentials not found for {self.business_id}")
                        self.calendar_service = None
                else:
                    # Simple database-based calendar
                    self.calendar_service = "simple_db"
            except Exception as e:
                print(f"Error initializing calendar service: {e}")
                self.calendar_service = None
        return self.calendar_service
    
    def get_database_connection(self):
        """Get database connection for this business"""
        try:
            import psycopg2
            db_config = self.config["database"]
            connection = psycopg2.connect(
                host=db_config["host"],
                port=db_config["port"],
                database=db_config["database"],
                user=db_config["user"],
                password=db_config["password"]
            )
            return connection
        except Exception as e:
            print(f"Error connecting to database: {e}")
            return None
    
    def send_whatsapp_message(self, to: str, message: str, media_url: Optional[str] = None) -> bool:
        """Send WhatsApp message via Hermes bridge"""
        try:
            # Use the existing WhatsApp bot infrastructure
            from hermes_tools import terminal
            
            # Send message through Hermes WhatsApp bot
            # This assumes we have a way to route messages to specific business sessions
            command = f"""
import sys
sys.path.insert(0, '/home/ubuntu/.hermes/skills/whatsapp-business-agent/scripts')
from whatsapp_bridge import send_business_message
send_business_message('{self.business_id}', '{to}', '''{message}''', {media_url is not None})
"""
            result = terminal(command=command.strip(), timeout=10)
            return result["exit_code"] == 0
        except Exception as e:
            print(f"Error sending WhatsApp message: {e}")
            return False
    
    def schedule_calendar_event(self, title: str, description: str, start_time: datetime, 
                              end_time: datetime, attendee_email: Optional[str] = None) -> bool:
        """Schedule appointment in calendar"""
        try:
            calendar_service = self.get_calendar_service()
            if calendar_service == "simple_db":
                # Store in business database
                conn = self.get_database_connection()
                if conn:
                    cursor = conn.cursor()
                    cursor.execute("""
                        INSERT INTO appointments (business_id, title, description, start_time, end_time, attendee_email, status)
                        VALUES (%s, %s, %s, %s, %s, %s, %s)
                    """, (self.business_id, title, description, start_time, end_time, attendee_email, "scheduled"))
                    conn.commit()
                    conn.close()
                    return True
                return False
            elif hasattr(calendar_service, 'events'):
                # Google Calendar
                event = {
                    'summary': title,
                    'description': description,
                    'start': {
                        'dateTime': start_time.isoformat(),
                        'timeZone': self.config["business"]["timezone"],
                    },
                    'end': {
                        'dateTime': end_time.isoformat(),
                        'timeZone': self.config["business"]["timezone"],
                    },
                }
                if attendee_email:
                    event['attendees'] = [{'email': attendee_email}]
                
                calendar_service.events().insert(calendarId='primary', body=event).execute()
                return True
            return False
        except Exception as e:
            print(f"Error scheduling calendar event: {e}")
            return False

# Global registry instance registry
_business_registries = {}

def get_provider_registry(business_id: str) -> WhatsAppBusinessProviderRegistry:
    """Get or create provider registry for a business"""
    if business_id not in _business_registries:
        _business_registries[business_id] = WhatsAppBusinessProviderRegistry(business_id)
    return _business_registries[business_id]
